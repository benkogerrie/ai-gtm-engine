# Copy to .env.local for local development:
#   cp .env.example .env.local
# Never commit real secrets. All values below are empty placeholders.

# Postgres. Leave empty to use in-process PGlite (local, tests, preview).
DATABASE_URL=

# Interim server-side API auth (never commit a real token).
# Data routes require Authorization: Bearer $APP_API_TOKEN.
# Browser login (/login) compares the same token and sets a signed httpOnly cookie.
# Org and actor are derived only from these server env vars — never from the client.
APP_API_TOKEN=
APP_ORG_ID=
APP_ACTOR_ID=
APP_ACTOR_TYPE=

# Public demo for judges. true/false. Unset defaults to ON when VERCEL_ENV=preview
# (no Vercel dashboard change needed). When on, pages and APIs skip the token /
# login cookie and map to APP_ORG_ID (or a server-side fallback org) + a human
# demo actor. Secrets stay server-side. Outreach stays dry-run only.
# PUBLIC_DEMO_MODE=
# Global daily cap for expensive demo actions (intake / ICP, discovery, outreach draft). Default 60.
# DEMO_MAX_RUNS_PER_DAY=

# --- LLM / reasoning layer (DeepSeek) ---
# DEEPSEEK_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=
# LLM_MAX_ATTEMPTS=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER_API_KEY=

# --- Discovery & search (Brave / Tavily / Serper / Playwright) ---
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# --- Knowledge graph (Neo4j or local Kùzu) ---
# NEO4J_URI=
# NEO4J_USER=
# NEO4J_PASSWORD=
# KUZU_DB_PATH=

# --- Enrichment (Hunter / Apollo / Clearbit) ---
# HUNTER_API_KEY=
# APOLLO_API_KEY=

# --- Messaging (SendGrid / Gmail / LinkedIn) ---
# SENDGRID_API_KEY=

# --- Billing bonus (Flexprice) ---
# FLEXPRICE_API_KEY=

# --- Optional: health endpoint commit override ---
# GIT_COMMIT=
