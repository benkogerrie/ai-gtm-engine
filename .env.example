# Copy to .env.local for local development:
#   cp .env.example .env.local
# Never commit real secrets. All values below are empty placeholders.

# --- LLM / reasoning layer ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER_API_KEY=

# --- Discovery & search (Brave / Tavily / Serper / Playwright) ---
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=

# --- Knowledge graph (Neo4j or local Kùzu) ---
# NEO4J_URI=
# NEO4J_USER=
# NEO4J_PASSWORD=
# KUZU_DB_PATH=

# --- Enrichment (Hunter / Apollo / Clearbit) ---
# HUNTER_API_KEY=
# APOLLO_API_KEY=

# --- Messaging (SendGrid / Gmail / LinkedIn) ---
# SENDGRID_API_KEY=

# --- Billing bonus (Flexprice) ---
# FLEXPRICE_API_KEY=

# --- Optional: health endpoint commit override ---
# GIT_COMMIT=
